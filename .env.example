# Akariya Tenka runtime configuration.
# Copy to .env only when a future launcher/environment loader is configured to use it.
AKARIYA_HOST=127.0.0.1
AKARIYA_PORT=4173
AKARIYA_DATA_DIR=./data
AKARIYA_WEB_DIST=./apps/web/dist
AKARIYA_LOG_LEVEL=info

# Bounded operational state.
AKARIYA_IDEMPOTENCY_TTL_HOURS=168
AKARIYA_IDEMPOTENCY_MAX_ENTRIES=10000
AKARIYA_AUDIT_MAX_BYTES=10485760
AKARIYA_AUDIT_MAX_ARCHIVES=5
AKARIYA_SHUTDOWN_TIMEOUT_MS=10000

# Runtime secrets are read only from AKARIYA_SECRET_* environment variables.
# Example name only; never commit a real key:
# AKARIYA_SECRET_OPENAI_API_KEY=
